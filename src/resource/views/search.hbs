

<h1 class='text-center pt-5 font-weight-bold pageTitle__center'>TÌM KIẾM</h1>

{{#if quatity includeZero=false}} 
  <p class='cart__quality text-center  mt-4 mb-5'>Có 
      <span class='cart__quality--number'>{{quatity}}</span> sản phẩm được tìm thấy
  </p>

  <p class='mt-4 mb-5'>
      Kết quả tìm kiếm cho "<span class='resultSearchedFor font-weight-bold'>
          {{resultSearchedFor}}
      </span>"
  </p>
  {{else}}

  <p class='cart__quality text-center font-weight-bold  mt-4 mb-5'>
    Không tìm thấy nội dung bạn yêu cầu <img class='iconImg'  src="img/Icons/sad.png" alt="">
  </p>

  <p class='mt-4 mb-5 text-center'>
     Không tìm thấy kết quả cho 
     <span class='resultSearchedFor font-weight-bold '>
          "{{resultSearchedFor}}"
      </span> 
      .Kiểm tra lại chính tả hoặc nhập các từ tổng quát hơn bạn nhá <img  class='iconImg' src="img/Icons/love.png" alt="">
  </p>


    <form  class='form__search form__search--inSearchPage active' action="/search">
        <input type="hidden" name='type' value='product'>
          <input
            type='text'
            name='text'
            placeholder='Search'
            id='search__input'
            autofocus='true'
          />
          <button type='submit' id='search__submit'>
            <i class='search__submit__icon fas fa-search'></i>
          </button>
    </form>
  
{{/if}}


 <div class='collection__product'>
        <div class='row'>
           {{#each products}}
               <div class='product__item col-6 col-lg-3 col-md-4'>
                      {{> productItem }}

              </div>
           {{/each}}
        </div>
</div>
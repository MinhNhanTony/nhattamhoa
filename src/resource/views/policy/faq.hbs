
<!-- =========================
     FAQ - NHẤT TÂM HOA
========================== -->

<section class="policy faq">

    <!-- HEADER -->
    <div class="faq__header">
        <span class="faq__eyebrow">
            NHẤT TÂM HOA
        </span>

        <h1 class="faq__title">
            Câu hỏi thường gặp
        </h1>

        <p class="faq__description">
            Những câu hỏi thường gặp khi lựa chọn, đặt và gửi hoa.
            Nếu bạn chưa tìm thấy thông tin cần biết, hãy liên hệ với
            Nhất Tâm Hoa để được hỗ trợ tận tình.
        </p>
    </div>


    <!-- FAQ LIST -->
    <div class="faq__list">

        <!-- ITEM 01 -->
        <div class="faq__item">

            <button class="faq__question">
                <span class="faq__number">01</span>

                <span class="faq__question-text">
                    Tôi có thể đặt hoa bằng cách nào?
                </span>

                <span class="faq__icon"></span>
            </button>

            <div class="faq__answer">
                <p>
                    Bạn có thể lựa chọn sản phẩm yêu thích trên website,
                    thêm vào giỏ hàng và điền đầy đủ thông tin đặt hoa.
                    Sau khi tiếp nhận đơn hàng, Nhất Tâm Hoa sẽ liên hệ
                    để xác nhận thông tin trước khi chuẩn bị và giao hoa.
                </p>
            </div>

        </div>


        <!-- ITEM 02 -->
        <div class="faq__item">

            <button class="faq__question">
                <span class="faq__number">02</span>

                <span class="faq__question-text">
                    Hoa thực tế có giống hình ảnh trên website không?
                </span>

                <span class="faq__icon"></span>
            </button>

            <div class="faq__answer">
                <p>
                    Nhất Tâm Hoa luôn cố gắng đảm bảo sản phẩm thực tế
                    có kiểu dáng và màu sắc tương đồng với hình ảnh
                    trên website. Tuy nhiên, hoa tươi là sản phẩm tự nhiên
                    nên kích thước, sắc độ và độ nở có thể có sự khác biệt
                    nhẹ tùy theo từng thời điểm.
                </p>
            </div>

        </div>


        <!-- ITEM 03 -->
        <div class="faq__item">

            <button class="faq__question">
                <span class="faq__number">03</span>

                <span class="faq__question-text">
                    Tôi có thể yêu cầu thay đổi loại hoa hoặc màu sắc không?
                </span>

                <span class="faq__icon"></span>
            </button>

            <div class="faq__answer">
                <p>
                    Có. Nếu bạn muốn thay đổi một số loại hoa, màu sắc
                    hoặc phong cách thiết kế, hãy ghi chú trong đơn hàng
                    hoặc liên hệ trực tiếp với Nhất Tâm Hoa. Chúng tôi sẽ
                    tư vấn phương án phù hợp dựa trên hoa đang có sẵn.
                </p>
            </div>

        </div>


        <!-- ITEM 04 -->
        <div class="faq__item">

            <button class="faq__question">
                <span class="faq__number">04</span>

                <span class="faq__question-text">
                    Tôi có thể đặt hoa để gửi trực tiếp cho người khác không?
                </span>

                <span class="faq__icon"></span>
            </button>

            <div class="faq__answer">
                <p>
                    Hoàn toàn được. Bạn chỉ cần cung cấp chính xác thông tin
                    người nhận, số điện thoại và địa chỉ giao hoa. Nhất Tâm Hoa
                    sẽ chuẩn bị và giao hoa trực tiếp đến người nhận theo
                    thông tin bạn cung cấp.
                </p>
            </div>

        </div>


        <!-- ITEM 05 -->
        <div class="faq__item">

            <button class="faq__question">
                <span class="faq__number">05</span>

                <span class="faq__question-text">
                    Tôi cần đặt hoa trước bao lâu?
                </span>

                <span class="faq__icon"></span>
            </button>

            <div class="faq__answer">
                <p>
                    Bạn nên đặt hoa trước thời gian cần nhận để chúng tôi
                    có thể chuẩn bị sản phẩm chu đáo nhất. Với những dịp
                    đặc biệt như Valentine, 8/3, 20/10, ngày lễ hoặc các
                    thiết kế theo yêu cầu, bạn nên đặt sớm để có nhiều
                    lựa chọn hơn.
                </p>
            </div>

        </div>


        <!-- ITEM 06 -->
        <div class="faq__item">

            <button class="faq__question">
                <span class="faq__number">06</span>

                <span class="faq__question-text">
                    Tôi có thể gửi lời nhắn kèm theo hoa không?
                </span>

                <span class="faq__icon"></span>
            </button>

            <div class="faq__answer">
                <p>
                    Có. Bạn có thể gửi lời nhắn để Nhất Tâm Hoa chuẩn bị
                    thiệp hoặc lời chúc đi kèm với hoa. Đây là một cách
                    đơn giản để món quà trở nên riêng tư và ý nghĩa hơn.
                </p>
            </div>

        </div>


        <!-- ITEM 07 -->
        <div class="faq__item">

            <button class="faq__question">
                <span class="faq__number">07</span>

                <span class="faq__question-text">
                    Tôi có thể thay đổi thông tin đơn hàng sau khi đặt không?
                </span>

                <span class="faq__icon"></span>
            </button>

            <div class="faq__answer">
                <p>
                    Nếu đơn hàng chưa được chuẩn bị, bạn có thể liên hệ
                    với Nhất Tâm Hoa để yêu cầu thay đổi thông tin như
                    địa chỉ, thời gian nhận hoặc lời nhắn. Chúng tôi sẽ
                    hỗ trợ trong khả năng có thể.
                </p>
            </div>

        </div>


        <!-- ITEM 08 -->
        <div class="faq__item">

            <button class="faq__question">
                <span class="faq__number">08</span>

                <span class="faq__question-text">
                    Tôi có thể đặt hoa trước cho những ngày đặc biệt không?
                </span>

                <span class="faq__icon"></span>
            </button>

            <div class="faq__answer">
                <p>
                    Có. Nhất Tâm Hoa khuyến khích khách hàng đặt trước
                    đối với những ngày có nhu cầu cao như Valentine,
                    8/3, 20/10, ngày lễ, sinh nhật hoặc các sự kiện
                    quan trọng để chúng tôi có thể chuẩn bị tốt nhất.
                </p>
            </div>

        </div>


        <!-- ITEM 09 -->
        <div class="faq__item">

            <button class="faq__question">
                <span class="faq__number">09</span>

                <span class="faq__question-text">
                    Nếu người nhận không có mặt khi giao hoa thì sao?
                </span>

                <span class="faq__icon"></span>
            </button>

            <div class="faq__answer">
                <p>
                    Đơn vị giao hàng sẽ liên hệ với người nhận theo số
                    điện thoại bạn cung cấp. Trong trường hợp không thể
                    liên lạc hoặc giao hàng, Nhất Tâm Hoa sẽ hỗ trợ
                    trao đổi với bạn để đưa ra phương án phù hợp.
                </p>
            </div>

        </div>


        <!-- ITEM 10 -->
        <div class="faq__item">

            <button class="faq__question">
                <span class="faq__number">10</span>

                <span class="faq__question-text">
                    Tôi cần tư vấn thêm thì liên hệ với Nhất Tâm Hoa ở đâu?
                </span>

                <span class="faq__icon"></span>
            </button>

            <div class="faq__answer">
                <p>
                    Nếu bạn cần tư vấn về mẫu hoa, màu sắc, ngân sách,
                    thời gian giao hoặc muốn thiết kế một sản phẩm riêng,
                    hãy liên hệ với Nhất Tâm Hoa qua các kênh hỗ trợ
                    được cung cấp trên website. Chúng tôi luôn sẵn sàng
                    hỗ trợ bạn lựa chọn món quà phù hợp nhất.
                </p>
            </div>

        </div>

    </div>


    <!-- CONTACT CTA -->
    <div class="faq__contact">

        <div class="faq__contact-content">
            <span class="faq__contact-eyebrow">
                BẠN CHƯA TÌM THẤY CÂU TRẢ LỜI?
            </span>

            <h2>
                Chúng tôi luôn sẵn sàng lắng nghe
            </h2>

            <p>
                Hãy liên hệ với Nhất Tâm Hoa để được tư vấn
                và hỗ trợ tận tình.
            </p>
        </div>

   
        <a href="tel:0962165084" class="faq__contact-btn">Liên hệ với chúng tôi</a>

    </div>

</section>



<style>
.faq {
    --flower-dark: #3f3a35;
    --flower-text: #625c56;
    --flower-accent: #9b7b67;
    --flower-light: #f8f5f1;
    --flower-border: #e6dfd8;

    max-width: 1100px;
    margin: 0 auto;
    padding: 90px 25px 110px;
    color: var(--flower-text);
}


/* =========================
   HEADER
========================= */

.faq__header {
    max-width: 720px;
    margin: 0 auto 65px;
    text-align: center;
}

.faq__eyebrow {
    display: block;
    margin-bottom: 16px;

    font-size: 12px;
    font-weight: 600;
    letter-spacing: 3px;
    color: var(--flower-accent);
}

.faq__title {
    margin: 0 0 20px;

    font-family: Georgia, "Times New Roman", serif;
    font-size: 46px;
    font-weight: 400;
    line-height: 1.2;
    color: var(--flower-dark);
}

.faq__description {
    margin: 0;

    font-size: 15px;
    line-height: 1.9;
    color: var(--flower-text);
}


/* =========================
   FAQ LIST
========================= */

.faq__list {
    max-width: 900px;
    margin: 0 auto;
    border-top: 1px solid var(--flower-border);
}

.faq__item {
    border-bottom: 1px solid var(--flower-border);
}


/* =========================
   QUESTION
========================= */

.faq__question {
    position: relative;

    display: grid;
    grid-template-columns: 55px 1fr 30px;
    align-items: center;

    width: 100%;
    padding: 25px 5px;

    border: 0;
    background: transparent;

    text-align: left;
    cursor: pointer;

    color: var(--flower-dark);
}

.faq__number {
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--flower-accent);
}

.faq__question-text {
    padding-right: 20px;

    font-family: Georgia, "Times New Roman", serif;
    font-size: 17px;
    line-height: 1.5;

    transition: color .3s ease;
}

.faq__question:hover .faq__question-text {
    color: var(--flower-accent);
}


/* =========================
   ICON
========================= */

.faq__icon {
    position: relative;

    width: 18px;
    height: 18px;
}

.faq__icon::before,
.faq__icon::after {
    content: "";

    position: absolute;
    top: 50%;
    left: 50%;

    width: 14px;
    height: 1px;

    background: var(--flower-dark);

    transform: translate(-50%, -50%);
    transition: transform .3s ease;
}

.faq__icon::after {
    transform:
        translate(-50%, -50%)
        rotate(90deg);
}


/* =========================
   ACTIVE
========================= */

.faq__item.active .faq__question-text {
    color: var(--flower-accent);
}

.faq__item.active .faq__icon::after {
    transform:
        translate(-50%, -50%)
        rotate(0deg);
}


/* =========================
   ANSWER
========================= */

.faq__answer {
    display: grid;
    grid-template-rows: 0fr;

    overflow: hidden;

    transition:
        grid-template-rows .35s ease,
        padding .35s ease;
}

.faq__answer p {
    min-height: 0;

    margin: 0;
    padding: 0 85px 0 55px;

    font-size: 14px;
    line-height: 1.9;

    color: var(--flower-text);
    opacity: 0;

    transition: opacity .25s ease;
}

.faq__item.active .faq__answer {
    grid-template-rows: 1fr;
}

.faq__item.active .faq__answer p {
    padding-bottom: 28px;
    opacity: 1;
}


/* =========================
   CONTACT
========================= */

.faq__contact {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;

    margin-top: 80px;
    padding: 45px 50px;

    background: var(--flower-light);
}

.faq__contact-eyebrow {
    display: block;
    margin-bottom: 12px;

    font-size: 10px;
    font-weight: 600;
    letter-spacing: 2px;

    color: var(--flower-accent);
}

.faq__contact h2 {
    margin: 0 0 10px;

    font-family: Georgia, "Times New Roman", serif;
    font-size: 27px;
    font-weight: 400;

    color: var(--flower-dark);
}

.faq__contact p {
    margin: 0;

    font-size: 14px;
    line-height: 1.7;
}

.faq__contact-btn {
    flex-shrink: 0;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-width: 180px;
    padding: 13px 25px;

    border: 1px solid var(--flower-dark);

    color: var(--flower-dark);
    text-decoration: none;

    font-size: 13px;
    transition: all .3s ease;
}

.faq__contact-btn:hover {
    background: var(--flower-dark);
    color: #fff;
}


/* =========================
   MOBILE
========================= */

@media (max-width: 767px) {

    .faq {
        padding: 60px 18px 80px;
    }

    .faq__header {
        margin-bottom: 45px;
    }

    .faq__title {
        font-size: 34px;
    }

    .faq__description {
        font-size: 14px;
        line-height: 1.8;
    }

    .faq__question {
        grid-template-columns: 38px 1fr 25px;
        padding: 21px 0;
    }

    .faq__number {
        font-size: 11px;
    }

    .faq__question-text {
        padding-right: 10px;
        font-size: 15px;
    }

    .faq__answer p {
        padding-left: 38px;
        padding-right: 25px;

        font-size: 13px;
        line-height: 1.8;
    }

    .faq__item.active .faq__answer p {
        padding-bottom: 22px;
    }

    .faq__contact {
        display: block;

        margin-top: 55px;
        padding: 35px 25px;
    }

    .faq__contact h2 {
        font-size: 23px;
    }

    .faq__contact p {
        margin-bottom: 25px;
    }

    .faq__contact-btn {
        width: 100%;
    }
}
</style>

<script>

document.querySelectorAll(".faq__question").forEach(function (question) {

    question.addEventListener("click", function () {

        const currentItem =
            question.closest(".faq__item");

        const isActive =
            currentItem.classList.contains("active");


        // Đóng tất cả câu hỏi khác
        document
            .querySelectorAll(".faq__item.active")
            .forEach(function (item) {

                if (item !== currentItem) {
                    item.classList.remove("active");
                }

            });


        // Toggle câu hỏi hiện tại
        if (isActive) {
            currentItem.classList.remove("active");
        } else {
            currentItem.classList.add("active");
        }

    });

});

</script>

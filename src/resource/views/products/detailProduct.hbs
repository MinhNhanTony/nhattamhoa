                </a>
                <a class="carousel-control-next" href="#ProductImgZoom" role="button" data-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="sr-only">Next</span>
                </a>
         </div>
      </div>
    </div>
  </div>
</div>


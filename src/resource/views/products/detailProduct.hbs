{{!-- viewmore --}}
<script>
    const descElement = document.querySelector('.productDesc');
    const viewMoreDescElement = document.querySelector('.view-more-desc');

    let descElementHeight = descElement.offsetHeight;
    let newDescElementHeight = (descElementHeight*20/100).toFixed();

    descElement.style.height = newDescElementHeight + "px";
  

   
    function toggleDescContent() {
        if(descElement.classList.contains('hide')) {
             descElement.style.height = descElementHeight + "px";
        }
        else {
             descElement.style.height = newDescElementHeight + "px";

        }
        descElement.classList.toggle('hide');

    }

    viewMoreDescElement.addEventListener('click',toggleDescContent)
    descElement.addEventListener('click',toggleDescContent)

  

    

</script>

<script>

    /* =========================================================
       1. CHỌN SIZE
       ========================================================= */

    const selectSizeBtns = document.querySelectorAll('.selectSize__btn--item');

    if (selectSizeBtns.length > 0) {

        selectSizeBtns.forEach((item) => {

            item.addEventListener('click', (e) => {

                const activeSize = document.querySelector('.selectSize__btn--item.active');

                if (activeSize) {
                    activeSize.classList.remove('active');
                }

                e.currentTarget.classList.add('active');

            });

        });

    }


    /* =========================================================
       2. PRODUCT IMAGE GALLERY
       
       - Mobile: vuốt trái/phải
       - Desktop: click thumbnail
       - Dấu chấm trên mobile
       - Nút Previous / Next
       ========================================================= */

    document.addEventListener('DOMContentLoaded', function () {

        const gallery = document.querySelector('.detailProduct__gallery');

        // Nếu trang không có gallery thì dừng
        if (!gallery) return;


        const slides = gallery.querySelectorAll(
            '.detailProduct__gallery-slide'
        );
       

        const dots = gallery.querySelectorAll(
            '.detailProduct__gallery-dot'
        );

        const thumbnails = gallery.querySelectorAll(
            '.detailProduct__gallery-thumbnail'
        );
        const gallerySlides = gallery.querySelectorAll(
            '.detailProduct__gallery-slide'
        );

        const prevButton = gallery.querySelector(
            '.detailProduct__gallery-arrow--prev'
        );

        const nextButton = gallery.querySelector(
            '.detailProduct__gallery-arrow--next'
        );


        // Không có ảnh thì dừng
        if (!slides.length) return;


        let currentIndex = 0;

        let touchStartX = 0;
        let touchStartY = 0;

        let touchEndX = 0;
        let touchEndY = 0;


        /* ---------------------------------------------------------
           Hiển thị ảnh
           --------------------------------------------------------- */

        function showSlide(index) {

            // Nếu index nhỏ hơn 0
            if (index < 0) {
                index = slides.length - 1;
            }

            // Nếu index lớn hơn ảnh cuối
            if (index >= slides.length) {
                index = 0;
            }

            currentIndex = index;


            /* Active ảnh chính */

            slides.forEach((slide, i) => {

                slide.classList.toggle(
                    'active',
                    i === currentIndex
                );

            });


            /* Active dots */

            dots.forEach((dot, i) => {

                dot.classList.toggle(
                    'active',
                    i === currentIndex
                );

            });


            /* Active thumbnail */

            thumbnails.forEach((thumbnail, i) => {

                thumbnail.classList.toggle(
                    'active',
                    i === currentIndex
                );

            });


            /* Cuộn thumbnail tới ảnh đang chọn */

            if (thumbnails[currentIndex]) {

                thumbnails[currentIndex].scrollIntoView({
                    behavior: 'smooth',
                    block: 'nearest',
                    inline: 'center'
                });

            }

        }


        /* ---------------------------------------------------------
           Nút Previous
           --------------------------------------------------------- */

        if (prevButton) {

            prevButton.addEventListener('click', function () {

                showSlide(currentIndex - 1);

            });

        }


        /* ---------------------------------------------------------
           Nút Next
           --------------------------------------------------------- */

        if (nextButton) {

            nextButton.addEventListener('click', function () {

                showSlide(currentIndex + 1);

            });

        }


        /* ---------------------------------------------------------
           Click dots
           --------------------------------------------------------- */

        dots.forEach((dot) => {

            dot.addEventListener('click', function () {

                const index = Number(this.dataset.index);

                showSlide(index);

            });

        });


        /* ---------------------------------------------------------
           Click thumbnail
           --------------------------------------------------------- */

        thumbnails.forEach((thumbnail) => {

            thumbnail.addEventListener('click', function () {

                const index = Number(this.dataset.index);

                showSlide(index);

            });

        });
                    /* =========================================================
            CLICK ẢNH CHÍNH → MỞ MODAL ZOOM
            ========================================================= */

            gallerySlides.forEach((slide) => {

                slide.addEventListener('click', function (event) {

                    /*
                    * Nếu đây là thao tác vuốt thì không mở modal.
                    * Chỉ click bình thường mới mở.
                    */

                    const index = Number(this.dataset.index);

                    // Đồng bộ ảnh đang xem
                    showSlide(index);

                    // Mở modal zoom
                    $('#ProductImgZoomModal').modal('show');

                });

            });


        /* =========================================================
           MOBILE SWIPE
           ========================================================= */

        gallery.addEventListener(
            'touchstart',
            function (event) {

                const touch = event.changedTouches[0];

                touchStartX = touch.screenX;
                touchStartY = touch.screenY;

            },
            {
                passive: true
            }
        );


        gallery.addEventListener(
            'touchend',
            function (event) {

                const touch = event.changedTouches[0];

                touchEndX = touch.screenX;
                touchEndY = touch.screenY;


                const distanceX =
                    touchEndX - touchStartX;

                const distanceY =
                    touchEndY - touchStartY;


                /*
                 * Chỉ xử lý nếu người dùng vuốt ngang.
                 *
                 * 50px là khoảng cách tối thiểu
                 * để tránh nhầm với click.
                 */

                if (
                    Math.abs(distanceX) > 50 &&
                    Math.abs(distanceX) > Math.abs(distanceY)
                ) {

                    // Vuốt sang trái → ảnh tiếp theo

                    if (distanceX < 0) {

                        showSlide(currentIndex + 1);

                    }

                    // Vuốt sang phải → ảnh trước

                    else {

                        showSlide(currentIndex - 1);

                    }

                }

            },
            {
                passive: true
            }
        );


        /* ---------------------------------------------------------
           Hiển thị ảnh đầu tiên
           --------------------------------------------------------- */

        showSlide(0);

    });



    /* =========================================================
       3. TĂNG / GIẢM SỐ LƯỢNG
       ========================================================= */

    function plusQuantity() {

        const quantityInput =
            document.getElementById('quantity');

        if (!quantityInput) return;


        const currentQuantity =
            Number(quantityInput.value) || 1;


        quantityInput.value =
            currentQuantity + 1;

    }


    function minusQuantity() {

        const quantityInput =
            document.getElementById('quantity');

        if (!quantityInput) return;


        const currentQuantity =
            Number(quantityInput.value) || 1;


        if (currentQuantity > 1) {

            quantityInput.value =
                currentQuantity - 1;

        }

    }



    /* =========================================================
       4. THÊM SẢN PHẨM VÀO GIỎ HÀNG
       ========================================================= */

    $('#cartModal').on(
        'show.bs.modal',
        async function (event) {

            const cartItemId =
                document.querySelector('#productId')?.value;


            if (!cartItemId) {
                return;
            }


            /* -----------------------------------------------------
               Lấy thông tin sản phẩm
               ----------------------------------------------------- */

            let productInfor;

            try {

                productInfor = await fetch(
                    `/products/infor/${cartItemId}`
                ).then((res) => {

                    return res.json();

                });

            }
            catch (error) {

                console.error(
                    'Không lấy được thông tin sản phẩm:',
                    error
                );

                return;

            }


            /* -----------------------------------------------------
               Ảnh sản phẩm
               ----------------------------------------------------- */

            const cartItemImgUrl =
                `{{productAvatar}}`;


            /* -----------------------------------------------------
               Tên sản phẩm
               ----------------------------------------------------- */

            const nameElement =
                document.querySelector(
                    '.product-detail__name'
                );


            const cartItemName =
                nameElement
                    ? nameElement.innerText
                    : '';



            /* =====================================================
               SIZE

               Đây là code cũ của giày.
               
               Vì Nhất Tâm Hoa không dùng size giày,
               nên không lấy .selectSize nữa.
               ===================================================== */

            let cartItemSize = null;

            const activeSize =
                document.querySelector(
                    '.selectSize__btn--item.active'
                );

            if (activeSize) {

                cartItemSize =
                    Number(activeSize.textContent);

            }



            /* =====================================================
               MÀU HOA

               Nếu sản phẩm hoa của bạn vẫn có .productColor__text
               thì lấy dữ liệu.

               Nếu không có thì để null.
               ===================================================== */

         let cartItemColor = null;

const colorElement =
    document.querySelector('.product-detail__color-circle');

if (colorElement) {

    cartItemColor =
        colorElement.dataset.color ||
        null;

}



            /* -----------------------------------------------------
               Số lượng
               ----------------------------------------------------- */

            const quantityElement =
                document.getElementById('quantity');


            const cartItemAmount =
                quantityElement
                    ? Number(quantityElement.value) || 1
                    : 1;



            /* -----------------------------------------------------
               Giá
               ----------------------------------------------------- */

            const priceElement =
                document.querySelector(
                    '.detailProduct__price'
                );


            const cartItemPrice =
                priceElement
                    ? Number(priceElement.dataset.price)
                    : 0;


            const cartItemPriceString =
                numberToMoney(cartItemPrice);



            /* -----------------------------------------------------
               Object sản phẩm trong giỏ
               ----------------------------------------------------- */

            const cartItemInfor = {

                cartItemId,

                cartItemImgUrl,

                cartItemName,

                cartItemSize,

                cartItemColor,

                cartItemAmount,

                cartItemPrice,

                cartItemSlug:
                    productInfor.slug,

                cartItemPriceString,

            };



            /* =====================================================
               LOCAL STORAGE
               ===================================================== */

            const localListCart =
                JSON.parse(
                    localStorage.getItem(
                        'cartProductList'
                    )
                );


            /* -----------------------------------------------------
               Đã có giỏ hàng
               ----------------------------------------------------- */

            if (localListCart !== null) {

                /*
                 * Với hoa, không nên dùng size để phân biệt
                 * sản phẩm.
                 *
                 * Tạm thời kiểm tra bằng product ID.
                 */

                const haveStoraged =
                    localListCart.some(
                        (item) =>
                            item.cartItemId ===
                            cartItemInfor.cartItemId
                    );
                    console.log(cartItemInfor)


                /* ---------------------------------------------
                   Sản phẩm đã có → tăng số lượng
                   --------------------------------------------- */

                if (haveStoraged) {

                    localListCart.forEach((item) => {

                        if (
                            item.cartItemId ===
                            cartItemInfor.cartItemId
                        ) {

                            item.cartItemAmount =
                                Number(item.cartItemAmount) +
                                cartItemAmount;

                        }

                    });

                }


                /* ---------------------------------------------
                   Sản phẩm mới
                   --------------------------------------------- */

                else {

                    localListCart.push(
                        cartItemInfor
                    );

                }


                /* ---------------------------------------------
                   Lưu lại
                   --------------------------------------------- */

                localStorage.setItem(
                    'cartProductList',
                    JSON.stringify(localListCart)
                );


                /* ---------------------------------------------
                   Render giỏ hàng
                   --------------------------------------------- */

                renderListCart(
                    localListCart
                );

            }


            /* -----------------------------------------------------
               Chưa có giỏ hàng
               ----------------------------------------------------- */

            else {

                const newCart = [
                    cartItemInfor
                ];


                localStorage.setItem(
                    'cartProductList',
                    JSON.stringify(newCart)
                );


                renderListCart(newCart);

            }

        }
    );



    /* =========================================================
       5. MODAL ZOOM ẢNH
       
       Khi click nút zoom:
       → modal mở
       → carousel hiển thị đúng ảnh đang xem
       ========================================================= */

    $('#ProductImgZoomModal').on(
        'show.bs.modal',
        function () {

            const gallery =
                document.querySelector(
                    '.detailProduct__gallery'
                );


            if (!gallery) return;


            const activeSlide =
                gallery.querySelector(
                    '.detailProduct__gallery-slide.active'
                );


            if (!activeSlide) return;


            const activeImgIndex =
                Number(
                    activeSlide.dataset.index
                );


            const carouselInnerElements =
                document.querySelectorAll(
                    '#ProductImgZoom .carousel-inner .carousel-item'
                );


            const carouselDotsElements =
                document.querySelectorAll(
                    '#ProductImgZoom .carousel-indicators li'
                );


            /* -----------------------------------------------------
               Active carousel image
               ----------------------------------------------------- */

            carouselInnerElements.forEach(
                (item, index) => {

                    if (index === activeImgIndex) {

                        item.classList.add('active');

                    }

                    else {

                        item.classList.remove('active');

                    }

                }
            );


            /* -----------------------------------------------------
               Active carousel dot
               ----------------------------------------------------- */

            carouselDotsElements.forEach(
                (item, index) => {

                    if (index === activeImgIndex) {

                        item.classList.add('active');

                    }

                    else {

                        item.classList.remove('active');

                    }

                }
            );


            /* -----------------------------------------------------
               Đồng bộ Bootstrap Carousel
               ----------------------------------------------------- */

            $('#ProductImgZoom').carousel(
                activeImgIndex
            );

        }
    );



    /* =========================================================
       6. BOOTSTRAP ZOOM CAROUSEL
       ========================================================= */

    $('#ProductImgZoom').carousel({

        interval: false,

        wrap: true

    });



    /* =========================================================
       7. SWIPE TRONG MODAL ZOOM
       ========================================================= */

    const zoomCarousel =
        document.getElementById(
            'ProductImgZoom'
        );


    if (zoomCarousel) {

        let zoomStartX = 0;
        let zoomStartY = 0;


        /* -----------------------------------------------------
           Touch start
           ----------------------------------------------------- */

        zoomCarousel.addEventListener(
            'touchstart',
            function (event) {

                const touch =
                    event.changedTouches[0];


                zoomStartX =
                    touch.screenX;

                zoomStartY =
                    touch.screenY;

            },
            {
                passive: true
            }
        );


        /* -----------------------------------------------------
           Touch end
           ----------------------------------------------------- */

        zoomCarousel.addEventListener(
    'touchend',
    function (event) {

        /*
         * ĐANG ZOOM
         * → tuyệt đối không cho Carousel next / prev
         */
        if (isZoomed) {
            return;
        }


        const touch =
            event.changedTouches[0];


        const zoomEndX =
            touch.screenX;

        const zoomEndY =
            touch.screenY;


        const distanceX =
            zoomEndX - zoomStartX;

        const distanceY =
            zoomEndY - zoomStartY;


        /*
         * Chỉ chuyển ảnh khi:
         *
         * 1. Kéo ngang đủ xa
         * 2. Kéo ngang nhiều hơn kéo dọc
         */
        if (
            Math.abs(distanceX) > 70 &&
            Math.abs(distanceX) > Math.abs(distanceY) * 1.5
        ) {

            if (distanceX < 0) {

                $('#ProductImgZoom')
                    .carousel('next');

            }

            else {

                $('#ProductImgZoom')
                    .carousel('prev');

            }

        }

    },
    {
        passive: true
    }
);
    }

</script>

<script>
        /* =====================================================
       CHẶN BOOTSTRAP CAROUSEL KHI ĐANG ZOOM
    ====================================================== */

    const zoomArea =
        document.getElementById('ProductImgZoom');


    if (zoomArea) {

        /*
         * TOUCH START
         */
        zoomArea.addEventListener(
            'touchstart',
            function (e) {

                if (!isZoomed) {
                    return;
                }

                const img =
                    e.target.closest(
                        '.zoom-product-image'
                    );

                if (!img) {
                    return;
                }

                /*
                 * Không cho Bootstrap Carousel
                 * nhận gesture.
                 */
                e.stopPropagation();

            },
            {
                capture: true,
                passive: false
            }
        );


        /*
         * TOUCH MOVE
         */
        zoomArea.addEventListener(
            'touchmove',
            function (e) {

                if (!isZoomed) {
                    return;
                }

                const img =
                    e.target.closest(
                        '.zoom-product-image'
                    );

                if (!img) {
                    return;
                }

                /*
                 * Đây là thao tác kéo ảnh zoom.
                 */
                e.preventDefault();

                e.stopPropagation();

            },
            {
                capture: true,
                passive: false
            }
        );


        /*
         * TOUCH END
         */
        zoomArea.addEventListener(
            'touchend',
            function (e) {

                if (!isZoomed) {
                    return;
                }

                const img =
                    e.target.closest(
                        '.zoom-product-image'
                    );

                if (!img) {
                    return;
                }

                e.stopPropagation();

            },
            {
                capture: true,
                passive: false
            }
        );


        /*
         * TOUCH CANCEL
         */
        zoomArea.addEventListener(
            'touchcancel',

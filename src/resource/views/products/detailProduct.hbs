<div class="detailProduct mt 5 pt-5">
    <div class="row">
        <div class="col-md-5 col-sm-12 detailProduct__img">

                <!-- =========================
                    MAIN GALLERY
                ========================== -->
                <div class="detailProduct__gallery">

                  <div class="detailProduct__gallery-main">

                        {{#each productInfor.productImg}}

                            <div
                                class="detailProduct__gallery-slide {{#if @first}}active{{/if}}"
                                data-index="{{@index}}"
                            >
                                <img
                                    src="{{this}}"
                                    alt="{{../productInfor.productName}} - ảnh {{@index}}"
                                    loading="{{#if @first}}eager{{else}}lazy{{/if}}"
                                >
                            </div>

                        {{/each}}


                        <button
                            type="button"
                            class="detailProduct__gallery-zoom"
                            data-toggle="modal"
                            data-target="#ProductImgZoomModal"
                            aria-label="Phóng to hình ảnh"
                        >
                            <img
                                src="/img/Icons/zoom.png"
                                alt="Phóng to"
                            >
                        </button>


                        <button
                            type="button"
                            class="detailProduct__gallery-arrow detailProduct__gallery-arrow--prev"
                            aria-label="Ảnh trước"
                        >
                            ‹
                        </button>


                        <button
                            type="button"
                            class="detailProduct__gallery-arrow detailProduct__gallery-arrow--next"
                            aria-label="Ảnh tiếp theo"
                        >
                            ›
                        </button>

                    </div>


                    <!-- =========================
                        DOTS MOBILE
                    ========================== -->

                    <div class="detailProduct__gallery-dots">

                        {{#each productInfor.productImg}}

                            <button
                                type="button"
                                class="detailProduct__gallery-dot {{#if @first}}active{{/if}}"
                                data-index="{{@index}}"
                                aria-label="Xem ảnh {{@index}}">
                            </button>

                        {{/each}}

                    </div>


                    <!-- =========================
                        THUMBNAILS DESKTOP
                    ========================== -->

                    <div class="detailProduct__gallery-thumbnails">

                        {{#each productInfor.productImg}}

                            <button
                                type="button"
                                class="detailProduct__gallery-thumbnail {{#if @first}}active{{/if}}"
                                data-index="{{@index}}">

                                <img
                                    src="{{this}}"
                                    alt="{{../productInfor.productName}}"
                                    loading="lazy"
                                >

                            </button>

                        {{/each}}

                    </div>

                </div>

            </div>
     
<div class="col-md-7 col-sm-12 detailProduct__content">

    <input type="hidden" id="productId" value="{{productInfor._id}}">

    <!-- ================= PRODUCT HEADER ================= -->
    <div class="product-detail__header">

        <div class="product-detail__category">
            <span>{{productInfor.category}}</span>
            <i class="fa-solid fa-circle"></i>
            <span>Mã SP: {{productInfor.productCode}}</span>
        </div>

        <h1 class="product-detail__name">
            {{productInfor.productName}}
        </h1>

    </div>


    <!-- ================= PRICE ================= -->
    <div class="product-detail__price-box">

        {{#if productInfor.sale includeZero=false}}

            <div class="product-detail__price-main">

                <span
                    class="product__newPrice detailProduct__price"
                    data-price="{{productInfor.productSalePrice}}">
                    {{number productInfor.productSalePrice}}₫
                </span>

                <span class="product__oldPrice detailProduct__price">
                    {{number productInfor.productPrice}}₫
                </span>

                <span class="product-detail__discount">
                    -{{productInfor.sale}}%
                </span>

            </div>

            <div class="product-detail__saving">
                <i class="fa-solid fa-tag"></i>
                Tiết kiệm
                {{number
                    (subtract
                        productInfor.productPrice
                        productInfor.productSalePrice
                    )
                }}₫
            </div>

        {{else}}

            <div class="product-detail__price-main">

                <span
                    class="product__oldPrice--notsale detailProduct__price"
                    data-price="{{productInfor.productPrice}}">
                    {{number productInfor.productPrice}}₫
                </span>

            </div>

        {{/if}}


        {{#if productInfor.isPreOrder}}

            <div class="product-detail__preorder">
                <span class="product-detail__preorder-icon">
                    <i class="fa-regular fa-calendar-check"></i>
                </span>

                <div>
                    <strong>Đặt trước sản phẩm</strong>
                    <small>Vui lòng đặt trước 1 ngày để shop chuẩn bị sản phẩm.</small>
                </div>
            </div>

        {{/if}}

    </div>


    <!-- ================= PROMOTION ================= -->
    <div class="product-detail__promotion">

        <div class="product-detail__section-title">

            <span class="product-detail__section-icon">
                <i class="fa-solid fa-gift"></i>
            </span>

            <span>Ưu đãi dành cho bạn</span>

        </div>


        <div class="product-detail__promotion-list">

            <div class="product-detail__promotion-item">

                <span class="promotion-check">
                    <i class="fa-solid fa-check"></i>
                </span>

                <div>
                    <strong>MIỄN PHÍ SHIP</strong>
                    <span>
                        Đơn hàng từ 500.000₫ trong bán kính 6km
                    </span>
                </div>

            </div>


            <div class="product-detail__promotion-item">

                <span class="promotion-check">
                    <i class="fa-solid fa-check"></i>
                </span>

                <div>
                    <strong>MIỄN PHÍ CHỈNH SỬA</strong>
                    <span>
                        Hỗ trợ chỉnh sửa nếu bạn chưa ưng ý sản phẩm, hỗ trợ tối đa trong khả năng của shop
                    </span>
                </div>

            </div>

        </div>

    </div>


    <!-- ================= COLOR + QUANTITY ================= -->
    <div class="product-detail__options">

        <!-- COLOR -->
        <div class="product-detail__option">

            <div class="product-detail__option-label">
                <span>Màu sắc</span>
            </div>

            <div class="product-detail__color">

                <span
                    class="product-detail__color-circle"
                    data-color="{{productInfor.productColor}}"
                    style="background-color:{{productInfor.productColor}}">
                </span>

                <span class="product-detail__color-code">
                    {{productInfor.productColor}}
                </span>

            </div>

        </div>


        <!-- QUANTITY -->
        <div class="product-detail__option product-detail__quantity">

            <div class="product-detail__option-label">
                <span>Số lượng</span>
            </div>

            <div class="quantity-control">

                <button
                    type="button"
                    onclick="minusQuantity()"
                    class="quantity-control__btn">
                    <i class="fa-solid fa-minus"></i>
                </button>

                <input
                    type="text"
                    id="quantity"
                    name="quantity"
                    value="1"
                    min="1"
                    class="quantity-control__input"
                    disabled>

                <button
                    type="button"
                    onclick="plusQuantity()"
                    class="quantity-control__btn">
                    <i class="fa-solid fa-plus"></i>
                </button>

            </div>

        </div>

    </div>


    <!-- ================= CTA ================= -->
    <div class="product-detail__actions">

        <button
            type="button"
            class="addToCart-btn product-detail__add-cart"
            data-toggle="modal"
            data-target="#cartModal"
            data-whatever="{{productInfor}}">

            <span class="product-detail__add-cart-icon">
                <i class="fa-solid fa-cart-shopping"></i>
            </span>

            <span>
                <strong>Thêm vào giỏ hàng</strong>
                <small>Tiếp tục mua sắm</small>
            </span>

            <i class="fa-solid fa-arrow-right product-detail__arrow"></i>

        </button>

    </div>


    <!-- ================= QUICK ORDER ================= -->
    <div class="product-detail__quick-order">

        <div class="quick-order__icon">
            <i class="fa-solid fa-phone"></i>
        </div>

        <div class="quick-order__content">

            <strong>Đặt hàng nhanh</strong>

            <span>
                Gọi ngay
                <a href="tel:{{hotline}}">
                    {{hotline}}
                </a>
                để được hỗ trợ
            </span>

        </div>

        <i class="fa-solid fa-chevron-right"></i>

    </div>


    <!-- ================= ORDER NOTE ================= -->
    <div class="product-detail__note">

        <div class="product-detail__note-icon">
            <i class="fa-brands fa-facebook-f"></i>
        </div>

        <div class="product-detail__note-content">

            <strong>Sản phẩm cần đặt trước?</strong>

            <p>
                Với những sản phẩm cần order, bạn vui lòng liên hệ
                <a
                    href="https://www.facebook.com/profile.php?id=100079283596226"
                    target="_blank">
                    Fanpage Nhất Tâm Hoa
                </a>
                để được nhân viên hỗ trợ đặt trước và thông báo ngay khi có hàng.
            </p>

        </div>

    </div>


    <!-- ================= SHIPPING ================= -->
    <div class="product-detail__benefits">

        <div class="product-detail__benefit">

            <span>
                <i class="fa-solid fa-truck-fast"></i>
            </span>

            <div>
                <strong>Miễn phí giao hàng</strong>
                <small>Đơn từ 500.000₫ · Bán kính 6km</small>
            </div>

        </div>


        <div class="product-detail__benefit">

            <span>
                <i class="fa-solid fa-shield-heart"></i>
            </span>

            <div>
                <strong>Hỗ trợ tận tâm</strong>
                <small>Luôn sẵn sàng hỗ trợ bạn</small>
            </div>

        </div>

    </div>


    <!-- ================= CART MODAL ================= -->
    <div
        class="modal right fade"
        id="cartModal"
        tabindex="-1"
        role="dialog"
        aria-labelledby="cartModalLabel2">

        <div class="modal-dialog" role="document">

            <div class="modal-content">

                <div class="modal-header">

                    <h4 class="modal-title" id="cartModalLabel2">
                        Giỏ hàng
                    </h4>

                    <button
                        type="button"
                        class="close close-cartModal-btn"
                        data-dismiss="modal"
                        aria-label="Close">

                        <span aria-hidden="true">
                            <i class="fa-solid fa-circle-xmark"></i>
                        </span>

                    </button>

                </div>


                <div class="modal-body">

                    <p class="cart__quality text-center mt-4 mb-5">
                        Bạn có
                        <span class="cart__quality--number"></span>
                        sản phẩm trong giỏ hàng
                    </p>

                    <ul class="cart__list"></ul>


                    <div class="d-flex justify-content-between my-5">

                        <span class="font-weight-bold">
                            TỔNG TIỀN
                        </span>

                        <span class="cart__total--money"></span>

                    </div>


                    <div class="cartBtn__container justify-content-between">

                        <a href="/cart">
                            {{> slideBtn title="Xem giỏ hàng"}}
                        </a>

                        <span>
                            {{> slideBtn title="Thanh toán" class="pay__btn"}}
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


            

          

            

        

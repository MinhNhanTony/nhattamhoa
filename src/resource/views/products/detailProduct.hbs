<script>
$(document).ready(function () {

    /* =====================================================
       CONFIG
    ====================================================== */

    const ZOOM_SCALE = 2.5;


    /* =====================================================
       STATE
    ====================================================== */

    let isZoomed = false;
    let isDragging = false;

    let currentImage = null;

    let translateX = 0;
    let translateY = 0;

    let startX = 0;
    let startY = 0;

    let startTranslateX = 0;
    let startTranslateY = 0;

    /*
     * Dùng để phân biệt:
     *
     * click
     * với
     * kéo ảnh
     */
    let moved = false;


    /* =====================================================
       APPLY TRANSFORM
    ====================================================== */

    function applyTransform(img) {

        if (!img) {
            return;
        }

        img.style.transform =
            `translate3d(
                calc(-50% + ${translateX}px),
                calc(-50% + ${translateY}px),
                0
            ) scale(${ZOOM_SCALE})`;

    }


    /* =====================================================
       RESET ZOOM
    ====================================================== */

    function resetZoom() {

        isZoomed = false;
        isDragging = false;
        moved = false;

        translateX = 0;
        translateY = 0;

        currentImage = null;

        document.body.style.userSelect = '';

        /*
         * Reset tất cả ảnh
         */
        $('#ProductImgZoom .carousel-item img').each(function () {

            this.classList.remove('is-zoomed');
            this.classList.remove('is-dragging');

            this.style.transform =
                'translate3d(-50%, -50%, 0) scale(1)';

        });

    }


    /* =====================================================
       TÍNH GIỚI HẠN KÉO
    ====================================================== */

    function clampPosition(img) {

        if (!img) {
            return;
        }


        const container =
            document.getElementById('ProductImgZoom');


        if (!container) {
            return;
        }


        /*
         * Lấy kích thước ảnh sau khi zoom
         */
        const imgRect =
            img.getBoundingClientRect();


        const containerRect =
            container.getBoundingClientRect();


        /*
         * Khoảng ảnh có thể vượt khỏi màn hình
         */
        const maxX =
            Math.max(
                0,
                (imgRect.width - containerRect.width) / 2
            );


        const maxY =
            Math.max(
                0,
                (imgRect.height - containerRect.height) / 2
            );


        /*
         * Giới hạn X
         */
        translateX =
            Math.max(
                -maxX,
                Math.min(
                    maxX,
                    translateX
                )
            );


        /*
         * Giới hạn Y
         */
        translateY =
            Math.max(
                -maxY,
                Math.min(
                    maxY,
                    translateY
                )
            );

    }


    /* =====================================================
       CLICK ĐỂ ZOOM TẠI ĐIỂM CLICK
    ====================================================== */

    $(document).on(
        'click',
        '#ProductImgZoom .carousel-item.active img',
        function (e) {

            /*
             * Nếu vừa kéo ảnh thì không xử lý click
             */
            if (moved) {
                moved = false;
                return;
            }


            const img = this;


            /*
             * Nếu đang zoom
             * → click để reset
             */
            if (img.classList.contains('is-zoomed')) {

                resetZoom();

                return;

            }


            const rect =
                img.getBoundingClientRect();


            /*
             * Vị trí click bên trong ảnh
             */
            const clickX =
                e.clientX - rect.left;


            const clickY =
                e.clientY - rect.top;


            /*
             * Tỷ lệ vị trí click
             */
            const percentX =
                clickX / rect.width;


            const percentY =
                clickY / rect.height;


            /*
             * Tính vị trí dịch
             */
            translateX =
                (
                    0.5 - percentX
                ) *
                rect.width *
                (
                    ZOOM_SCALE - 1
                );


            translateY =
                (
                    0.5 - percentY
                ) *
                rect.height *
                (
                    ZOOM_SCALE - 1
                );


            isZoomed = true;

            currentImage = img;


            img.classList.add(
                'is-zoomed'
            );


            /*
             * Apply zoom
             */
            applyTransform(img);


            /*
             * Giới hạn vị trí
             */
            requestAnimationFrame(function () {

                clampPosition(img);

                applyTransform(img);

            });

        }
    );


    /* =====================================================
       POINTER DOWN
       Hỗ trợ:
       - Mouse
       - Touch
       - Pen
    ====================================================== */

$(document).on(
    'pointerdown',
    '#ProductImgZoom .carousel-item.active img',
    function (e) {

        if (!isZoomed) {
            return;
        }


        const img = this;

        currentImage = img;


        isDragging = true;
        moved = false;


        startX = e.clientX;
        startY = e.clientY;


        startTranslateX = translateX;
        startTranslateY = translateY;


        img.classList.add('is-dragging');


        /*
         * Giữ pointer trên chính ảnh
         */
        try {

            img.setPointerCapture(
                e.pointerId
            );

        } catch (error) {}


        document.body.style.userSelect =
            'none';


        /*
         * QUAN TRỌNG
         *
         * Chặn Bootstrap Carousel
         */
        e.preventDefault();
        e.stopPropagation();

    }
);
    /* =====================================================
       POINTER MOVE
    ====================================================== */

$(document).on(
    'pointermove',
    '#ProductImgZoom .carousel-item.active img',
    function (e) {

        if (!isZoomed || !isDragging) {
            return;
        }


        const img = this;


        /*
         * Độ nhạy kéo
         *
         * 1    = bình thường
         * 0.8  = hơi chậm
         * 0.65 = dễ kiểm soát
         * 0.5  = rất nhẹ
         */
        const DRAG_SENSITIVITY = 0.65;


        /*
         * Khoảng cách thực tế người dùng kéo
         */
        const rawDeltaX =
            e.clientX - startX;

        const rawDeltaY =
            e.clientY - startY;


        /*
         * Giảm độ nhạy
         */
        const deltaX =
            rawDeltaX * DRAG_SENSITIVITY;

        const deltaY =
            rawDeltaY * DRAG_SENSITIVITY;


        /*
         * Phải kéo ít nhất 10px
         * mới tính là đang kéo ảnh
         */
        const DRAG_THRESHOLD = 10;


        if (
            Math.abs(rawDeltaX) > DRAG_THRESHOLD ||
            Math.abs(rawDeltaY) > DRAG_THRESHOLD
        ) {

            moved = true;

        }


        /*
         * Tính vị trí mới
         */
        translateX =
            startTranslateX + deltaX;

        translateY =
            startTranslateY + deltaY;


        /*
         * Không cho ảnh kéo ra ngoài vùng cho phép
         */
        clampPosition(img);


        /*
         * Render
         */
        applyTransform(img);


        /*
         * QUAN TRỌNG:
         *
         * Không cho Bootstrap Carousel
         * nhận gesture này.
         */
        e.preventDefault();
        e.stopPropagation();

    }
);
    /* =====================================================
       POINTER UP
    ====================================================== */

    $(document).on(
        'pointerup pointercancel',
        '#ProductImgZoom .carousel-item.active img',
        function (e) {

            if (!isDragging) {
                return;
            }


            isDragging = false;


            document.body.style.userSelect =
                '';


            this.classList.remove(
                'is-dragging'
            );


            /*
             * Release pointer
             */
            try {

                this.releasePointerCapture(
                    e.pointerId
                );

            } catch (error) {
                // Không làm gì
            }

        }
    );


    /* =====================================================
       DOUBLE CLICK
       → RESET ZOOM
    ====================================================== */

    $(document).on(
        'dblclick',
        '#ProductImgZoom .carousel-item.active img',
        function () {

            resetZoom();

        }
    );


    /* =====================================================
       KHI CAROUSEL CHUYỂN ẢNH
       → RESET ZOOM
    ====================================================== */

    $('#ProductImgZoom').on(
        'slide.bs.carousel',

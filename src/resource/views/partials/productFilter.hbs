<!-- ==============================
     DESKTOP FILTER
================================ -->

<div class="col-md-3 col-sm-12 col-xs-12 product-filter-column">

    <div class="product-filter-desktop">

        <div
            class="filter-header"
            data-toggle="collapse"
            data-target="#collapseOne"
        >
            <span class="title">Bộ lọc</span>

            <span class="accicon">
                <i class="fa-solid fa-chevron-down"></i>
            </span>
        </div>

        <div id="collapseOne" class="collapse">

            <form class="filter">

                <!-- LOẠI HOA -->

                <div class="group__filter">

                    <p class="group__filter--title">
                        Loại hoa
                    </p>

                    <ul>

                        {{#each categoryList}}

                        <li>

                            <div class="form-check">

                                <input
                                    class="form-check-input checkAndRadio"
                                    type="checkbox"
                                    name="category"
                                    value="{{this.categoryName}}"
                                    id="category{{this.categoryName}}"
                                >

                                <label
                                    class="form-check-label"
                                    for="category{{this.categoryName}}"
                                >
                                    {{this.categoryName}}
                                </label>

                            </div>

                        </li>

                        {{/each}}

                    </ul>

                </div>


                <!-- GIÁ -->

                <div class="group__filter">

                    <p class="group__filter--title">
                        Giá sản phẩm
                    </p>

                    <ul>

                        {{#each priceRange}}

                        <li>

                            <div class="form-check">

                                <input
                                    class="form-check-input checkAndRadio"
                                    type="radio"
                                    name="price"
                                    value="{{this.from}}-{{this.to}}"
                                    id="range{{this.from}}"
                                >

                                <label
                                    class="form-check-label"
                                    for="range{{this.from}}"
                                >
                                    {{this.valueString}}
                                </label>

                            </div>

                        </li>

                        {{/each}}

                    </ul>

                </div>


                <!-- MÀU -->

                <div class="group__filter filter__color">

                    <p class="group__filter--title">
                        Màu sắc
                    </p>

                    <ul>

                        {{#each listColor}}

                        <li>

                            <input
                                style="display:none"
                                type="checkbox"
                                name="color"
                                value="{{this}}"
                                id="color-{{this}}"
                                class="checkAndRadio"
                            >

                            <label
                                style="background-color:{{this}}"
                                class="p-4"
                                for="color-{{this}}"
                            ></label>

                        </li>

                        {{/each}}

                    </ul>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- ==============================
     MOBILE FILTER BUTTON
================================ -->

<button
    type="button"
    class="mobile-filter-button"
    id="mobileFilterButton"
>
    <i class="fa-solid fa-sliders"></i>
    <span>Filter</span>
</button>


<!-- ==============================
     MOBILE FILTER DRAWER
================================ -->

<div
    class="mobile-filter-drawer"
    id="mobileFilterDrawer"
>

    <div class="mobile-filter-drawer__header">

        <div>

            <h3>Bộ lọc</h3>

            <span>
                Lọc sản phẩm
            </span>

        </div>

        <button
            type="button"
            class="mobile-filter-drawer__close"
            id="mobileFilterClose"
        >
            <i class="fa-solid fa-xmark"></i>
        </button>

    </div>


    <div class="mobile-filter-drawer__body">

        <form class="filter">

            <!-- LOẠI HOA -->

            <div class="group__filter">

                <p class="group__filter--title">
                    Loại hoa
                </p>

                <ul>

                    {{#each categoryList}}

                    <li>

                        <div class="form-check">

                            <input
                                class="form-check-input checkAndRadio"
                                type="checkbox"
                                name="category"
                                value="{{this.categoryName}}"
                            >

                            <label class="form-check-label">
                                {{this.categoryName}}
                            </label>

                        </div>

                    </li>

                    {{/each}}

                </ul>

            </div>


            <!-- GIÁ -->

            <div class="group__filter">

                <p class="group__filter--title">
                    Giá sản phẩm
                </p>

                <ul>

                    {{#each priceRange}}

                    <li>

                        <div class="form-check">

                            <input
                                class="form-check-input checkAndRadio"
                                type="radio"
                                name="price"
                                value="{{this.from}}-{{this.to}}"
                            >

                            <label class="form-check-label">
                                {{this.valueString}}
                            </label>

                        </div>

                    </li>

                    {{/each}}

                </ul>

            </div>


            <!-- MÀU -->

            <div class="group__filter filter__color">

                <p class="group__filter--title">
                    Màu sắc
                </p>

                <ul>

                    {{#each listColor}}

                    <li>

                        <input
                            type="checkbox"
                            name="color"
                            value="{{this}}"
                            class="checkAndRadio"
                            id="mobile-color-{{this}}"
                        >

                        <label
                            style="background-color:{{this}}"
                            for="mobile-color-{{this}}"
                        ></label>

                    </li>

                    {{/each}}

                </ul>

            </div>

        </form>

    </div>

</div>


<!-- LỚP MỜ -->
<div
    class="mobile-filter-backdrop"
    id="mobileFilterBackdrop"
></div>

<script>
    document.addEventListener('DOMContentLoaded', function () {

    const button =
        document.getElementById('mobileFilterButton');

    const drawer =
        document.getElementById('mobileFilterDrawer');

    const close =
        document.getElementById('mobileFilterClose');

    const backdrop =
        document.getElementById('mobileFilterBackdrop');


    if (!button || !drawer || !close || !backdrop) {
        return;
    }


    function openFilter() {

        drawer.classList.add('active');

        backdrop.classList.add('active');
    }


    function closeFilter() {

        drawer.classList.remove('active');

        backdrop.classList.remove('active');
    }


    button.addEventListener(
        'click',
        openFilter
    );


    close.addEventListener(
        'click',
        closeFilter
    );


    backdrop.addEventListener(
        'click',
        closeFilter
    );

});
</script>
<script>
        const allCheckbox = document.querySelectorAll('.group__filter input.checkAndRadio');
  
        
        function checkBoxListenEvent () {
            allCheckbox.forEach((item)=> {
                item.addEventListener('click',()=> {
                    const allCheckedbox = document.querySelectorAll('.group__filter input.checkAndRadio:checked');
                    let getProductWithFilterUrl = `/apis/productsWithFilter`;
                    if(allCheckedbox.length === 0) {
                        fetchProductWithQuery(getProductWithFilterUrl);
                    };
                    allCheckedbox.forEach((item)=> {
                            //  Get List color
                        let params = [];
                        allCheckedbox.forEach((c) => {
                            if (!params.includes(c.name)) {
                                params.push(c.name);
                            }
                        });

                        // Get gender param
                        function renderParams (param) {
                              const CheckedElement = document.querySelectorAll(`input[name="${param}"]:checked`);

                                return  [...CheckedElement].map((e)=> {
                                   return e.value;
                                })
                        }
                       
                        const genderParamString = renderParams('gender');
                        const categoryParamString =  renderParams('category');
                        const priceParamString =renderParams('price');
                        const colorParamString = renderParams('color');

                    
                      

                        const dataForPost =
                        {
                            gender:genderParamString,
                            category:categoryParamString,
                            price:priceParamString,
                            color:colorParamString,
                        }

                        fetchProductWithQuery(getProductWithFilterUrl,dataForPost);
                    
                    })

                })
            })
        }
        checkBoxListenEvent();
        async function postData(url = '', data = {}) {
            // Default options are marked with *
            const response = await fetch(url, {
                method: 'POST', 
                mode: 'cors', 
                cache: 'no-cache', 
                credentials: 'same-origin', 
                headers: {
                    'Content-Type': 'application/json'
                    // 'Content-Type': 'application/x-www-form-urlencoded',
                    },
                redirect: 'follow', // manual, *follow, error
                referrerPolicy: 'no-referrer', // no-referrer, *no-referrer-when-downgrade, origin, origin-when-cross-origin, same-origin, strict-origin, strict-origin-when-cross-origin, unsafe-url
                body: JSON.stringify(data) // body data type must match "Content-Type" header
            });
            return response.json();
            }

        function fetchProductWithQuery (getProductWithFilterUrl,dataForPost) {
            postData(getProductWithFilterUrl,dataForPost)
            .then(data=> {
                        const {products} = data;
                       const productListRowElement = document.querySelector('.product__list .row');
                       productListRowElement.innerHTML = '';

                       function renderProductList() {
                            const ProductListHtml = products.map((product)=> {
                            const isSale = product.sale;
                            let saleHtml ;
                            let priceHtml;

                            if(isSale) {
                                saleHtml = `<div            class='product__sale'><span>GIẢM ${product.sale}%</span>
                                </div>`

                                priceHtml = `<div class='product__price'>
                                                    <span class='product__newPrice'>${numberToMoney(product.productSalePrice)}</span>
                                                    <span class='product__oldPrice'>${numberToMoney(product.productPrice)}</span>
                                        
                                        
                                                </div>`
                            }
                            else {
                                saleHtml='';
                                priceHtml = `<div class='product__price'>
                                                    <span class='product__oldPrice--notsale'>${numberToMoney(product.productPrice)}</span>
                                             </div>`
                            }

                              return `
    <div class="product__item col-6 col-md-3">

        <div class="product__area">

            <!-- =========================
                 PRODUCT IMAGE
            ========================== -->
            <div class="product__IMG">

                <a
                    href="/products/${product.slug}"
                    class="product__image-link"
                >

                    <img
                        src="${product.productImg?.[0] || ''}"
                        alt="${product.productName || ''}"
                        loading="lazy"
                    />

                    ${saleHtml}

                </a>

            </div>


            <!-- =========================
                 PRODUCT DETAIL
            ========================== -->
            <div class="product__detail">

                <!-- Tên sản phẩm -->
                <a
                    href="/products/${product.slug}"
                    class="product__name"
                >
                    ${product.productName || ''}
                </a>


                <!-- Mô tả sản phẩm -->
                <p class="product__description">
                    ${
                        product.productDescription
                            ?.map(item => item.descText)
                            .join(' ') || ''
                    }
                </p>


                <!-- =========================
                     PRICE
                ========================== -->

                ${priceHtml}


                <!-- =========================
                     FOOTER
                ========================== -->

                <div class="product__detail--footer">

                    <a
                        href="/products/${product.slug}"
                        class="product__detail-link"
                    >

                        <span>Xem chi tiết</span>

                        <span class="product__detail-arrow">
                            →
                        </span>

                    </a>

                </div>

            </div>

        </div>

    </div>
`;
                            })
                            productListRowElement.innerHTML = ProductListHtml.join("");
                       }
                       renderProductList()
                      

                    }).catch(error=> {
                        console.log(error);
                    })
        }


        window.addEventListener("resize",function(event) {
            checkScreeToShowFilter();  
        }) 
        function checkScreeToShowFilter() {
            if(window.innerWidth > 768) {
                $('.collapse').collapse();
            
            }
        }
         
        checkScreeToShowFilter();
           
        
</script>
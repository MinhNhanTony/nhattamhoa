<!-- =========================================================
     HEADER JAVASCRIPT
========================================================= -->

<script>

document.addEventListener('DOMContentLoaded', function () {


    /* =====================================================
       SEARCH
    ====================================================== */

    const searchWrapper =
        document.querySelector('.header-search');

    const searchButton =
        document.querySelector('.header-search__button');

    const searchForm =
        document.querySelector('.header-search__form');


    if (searchButton && searchWrapper) {

        searchButton.addEventListener(
            'click',
            function (e) {

                e.preventDefault();

                e.stopPropagation();

                searchWrapper.classList.toggle(
                    'is-open'
                );

                if (
                    searchWrapper.classList.contains(
                        'is-open'
                    )
                ) {

                    const input =
                        searchWrapper.querySelector(
                            'input[type="text"]'
                        );

                    if (input) {
                        setTimeout(
                            () => input.focus(),
                            100
                        );
                    }

                }

            }
        );

    }


    if (searchForm) {

        searchForm.addEventListener(
            'click',
            function (e) {

                e.stopPropagation();

            }
        );

    }


    document.addEventListener(
        'click',
        function () {

            if (searchWrapper) {

                searchWrapper.classList.remove(
                    'is-open'
                );

            }

        }
    );


    /* =====================================================
       LOAD CATEGORY FROM DATABASE
    ====================================================== */

    const desktopCategoryList =
        document.querySelector(
            '#megaCategoryList'
        );

    const mobileCategoryList =
        document.querySelector(
            '#mobileCategoryList'
        );


    if (
        desktopCategoryList ||
        mobileCategoryList
    ) {

        fetch('/apis/category-list')

            .then(function (response) {

                if (!response.ok) {

                    throw new Error(
                        'Không thể tải danh mục'
                    );

                }

                return response.json();

            })

            .then(function (data) {

                console.log(
                    'Category:',
                    data
                );


                if (
                    !Array.isArray(data) ||
                    data.length === 0
                ) {

                    const emptyHTML = `
                        <div class="mega-category-empty">
                            Chưa có danh mục
                        </div>
                    `;


                    if (desktopCategoryList) {

                        desktopCategoryList.innerHTML =
                            emptyHTML;

                    }


                    if (mobileCategoryList) {

                        mobileCategoryList.innerHTML =
                            emptyHTML;

                    }

                    return;
                }


                const categoryHTML = data

                    .map(function (item) {

                        const categoryName =
                            item.categoryName || '';


                        if (!categoryName) {

                            return '';

                        }


                        return `

                            <a
                                href="/collections/category/${encodeURIComponent(categoryName)}"
                                class="mega-category-link"
                            >

                                <span>
                                    ${categoryName}
                                </span>

                                <i class="fas fa-arrow-right"></i>

                            </a>

                        `;

                    })

                    .join('');


                /* DESKTOP */

                if (desktopCategoryList) {

                    desktopCategoryList.innerHTML =
                        categoryHTML;

                }


                /* MOBILE */

                if (mobileCategoryList) {

                    mobileCategoryList.innerHTML =
                        categoryHTML;

                }

            })

            .catch(function (error) {

                console.error(
                    'Category error:',
                    error
                );


                const errorHTML = `
                    <div class="mega-category-empty">
                        Không thể tải danh mục
                    </div>
                `;


                if (desktopCategoryList) {

                    desktopCategoryList.innerHTML =
                        errorHTML;

                }


                if (mobileCategoryList) {

                    mobileCategoryList.innerHTML =
                        errorHTML;

                }

            });

    }


    /* =====================================================
       MOBILE MENU
    ====================================================== */

    const mobileToggle =
        document.querySelector(
            '.header-mobile-toggle'
        );

    const mobileMenu =
        document.querySelector(
            '.mobile-menu'
        );

    const mobileClose =
        document.querySelector(
            '.mobile-menu__close'
        );

    const mobileOverlay =
        document.querySelector(
            '.mobile-menu__overlay'
        );


    function openMobileMenu() {

        if (!mobileMenu) return;

        mobileMenu.classList.add(
            'is-open'
        );

        if (mobileOverlay) {

            mobileOverlay.classList.add(
                'is-open'
            );

        }

        document.body.classList.add(
            'menu-open'
        );

    }


    function closeMobileMenu() {

        if (!mobileMenu) return;

        mobileMenu.classList.remove(
            'is-open'
        );

        if (mobileOverlay) {

            mobileOverlay.classList.remove(
                'is-open'
            );

        }

        document.body.classList.remove(
            'menu-open'
        );

    }


    if (mobileToggle) {

        mobileToggle.addEventListener(
            'click',
            openMobileMenu
        );

    }


    if (mobileClose) {

        mobileClose.addEventListener(
            'click',
            closeMobileMenu
        );

    }


    if (mobileOverlay) {

        mobileOverlay.addEventListener(
            'click',
            closeMobileMenu
        );

    }


    /* =====================================================
       MOBILE CATEGORY TOGGLE
    ====================================================== */

    const mobileCategory =
        document.querySelector(
            '.mobile-menu__category'
        );


    const categoryToggle =
        document.querySelector(
            '.mobile-menu__category-toggle'
        );


    if (
        mobileCategory &&
        categoryToggle
    ) {

        categoryToggle.addEventListener(
            'click',
            function () {

                mobileCategory.classList.toggle(
                    'is-open'
                );

            }
        );

    }


    /* =====================================================
       CLOSE MOBILE MENU WHEN CLICK LINK
    ====================================================== */

    if (mobileMenu) {

        const mobileLinks =
            mobileMenu.querySelectorAll(
                'a'
            );


        mobileLinks.forEach(
            function (link) {

                link.addEventListener(
                    'click',
                    function () {

                        closeMobileMenu();

                    }
                );

            }
        );

    }


    /* =====================================================
       STICKY HEADER
    ====================================================== */


document.addEventListener('DOMContentLoaded', function () {

    const siteHeader =
        document.querySelector('.site-header');

    if (!siteHeader) return;


    let ticking = false;


    function updateHeader() {

        if (window.scrollY > 30) {

            siteHeader.classList.add('is-sticky');

        } else {

            siteHeader.classList.remove('is-sticky');

        }

        ticking = false;

    }


    window.addEventListener(
        'scroll',
        function () {

            if (!ticking) {

                window.requestAnimationFrame(
                    updateHeader
                );

                ticking = true;

            }

        },
        {
            passive: true
        }
    );


    updateHeader();

});



    /* =====================================================
       CART COUNT
    ====================================================== */

    const cartNumber =
        document.querySelector(
            '.header-cart__number'
        );


    if (cartNumber) {

        let cartList = [];


        try {

            cartList =
                JSON.parse(
                    localStorage.getItem(
                        'cartProductList'
                    ) || '[]'
                );

        } catch (error) {

            console.error(
                'Cart error:',
                error
            );

            cartList = [];

        }


        if (
            !Array.isArray(cartList) ||
            cartList.length === 0
        ) {

            cartNumber.classList.add(
                'is-empty'
            );

        } else {

            cartNumber.classList.remove(
                'is-empty'
            );


            cartNumber.textContent =
                cartList.length > 99
                    ? '99+'
                    : cartList.length;

        }

    }

});

</script>
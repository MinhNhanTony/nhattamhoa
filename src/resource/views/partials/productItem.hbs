<div class="product__area">

    <!-- =========================
         PRODUCT IMAGE
    ========================== -->
    <div class="product__IMG">

        <a href="/products/{{this.slug}}" class="product__image-link">

            <img
                src="{{this.productImg.[0]}}"
                alt="{{this.productName}}"
                loading="lazy"
            />

            {{#if this.sale includeZero=false}}
                <div class="product__sale">
                    -{{this.sale}}%
                </div>
            {{/if}}

        </a>

    </div>


    <!-- =========================
         PRODUCT DETAIL
    ========================== -->
    <div class="product__detail">

        <!-- Tên sản phẩm -->
        <a
            href="/products/{{this.slug}}"
            class="product__name"
        >
            {{this.productName}}
        </a>


        <!-- Mô tả sản phẩm -->
        <p class="product__description">
            {{#each this.productDescription}}
              {{this.descText}}
          {{/each}}
        </p>


        <!-- =========================
             PRICE
        ========================== -->
        <div class="product__price">

            {{#if this.sale includeZero=false}}

                <span class="product__newPrice">
                    {{number this.productSalePrice}}₫
                </span>

                <span class="product__oldPrice">
                    {{number this.productPrice}}₫
                </span>

            {{else}}

                <span class="product__oldPrice--notsale">
                    {{number this.productPrice}}₫
                </span>

            {{/if}}

        </div>


        <!-- =========================
             FOOTER
        ========================== -->
        <div class="product__detail--footer">

            <a
                href="/products/{{this.slug}}"
                class="product__detail-link"
            >
                <span>Xem chi tiết</span>

                <span class="product__detail-arrow">
                    →
                </span>
            </a>

        </div>

    </div>

</div>
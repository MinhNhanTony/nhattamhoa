                    itemPrice * amount;



                return `
                    <div class="cart__row cart__body--row">

                        <div class="cart__item--main">

                            <div class="cart__item-image">
                                <img
                                    src="${item.cartItemImgUrl}"
                                    alt="${item.cartItemName || ''}"
                                >
                            </div>

                            <div class="cart__item-info">

                                <p class="cart__item-name">
                                    ${item.cartItemName || ''}
                                </p>

                            </div>

                        </div>


                        <div class="cart__item--type">

                            <div>
                                Màu:
                                <span style=background-color:${item.cartItemColor || '--'} class="cart__item--color">
                                    
                                </span>
                            </div>

                        </div>


                        <div class="cart__item-price">
                            ${numberToMoney(itemPrice)}
                        </div>


                        <div class="cart__item-quantity">
                            ${amount}
                        </div>


                        <div class="cart__item-total">
                            ${numberToMoney(itemTotal)}
                        </div>

                    </div>
                `;
            });

        cartBodyElement.innerHTML =
            cartBodyHTML.join('');


        // =========================================
        // TÍNH TỔNG TIỀN HÀNG
        // =========================================

        productPrice =
            cartProductList.reduce(
                (total, item) => {

                    const price =
                        Number(item.cartItemPrice) || 0;

                    const amount =
                        Number(item.cartItemAmount) || 0;

                    return total + (price * amount);

                },
                0
            );


        // =========================================
        // PHÍ SHIP = 0
        // =========================================

        shipmentFee = 0;


        // =========================================
        // TỔNG THANH TOÁN
        // =========================================

        totalPrice =
            productPrice;


        // Tổng tiền hàng
        const productPriceElement =
            document.querySelector(
                '.total__product--price'
            );

        if (productPriceElement) {

            productPriceElement.innerHTML =
                numberToMoney(productPrice);

        }


        // Phí vận chuyển = 0
        const shipElement =
            document.querySelector(
                '.total__feeShip--price'
            );

        if (shipElement) {

            shipElement.innerHTML =
                numberToMoney(0);

        }


        // Tổng thanh toán
        const orderPriceElement =
            document.querySelector(
                '.total__order--price'
            );

        if (orderPriceElement) {

            orderPriceElement.innerHTML =
                numberToMoney(totalPrice);

        }


        // Tổng trước giảm giá
        const originalTotalElement =
            document.querySelector(
                '.originalTotalPrice'
            );

        if (originalTotalElement) {

            originalTotalElement.innerHTML =
                numberToMoney(totalPrice);

        }


        // =========================================
        // CHO PHÉP ĐẶT HÀNG
        // =========================================

        const orderBtn =
            document.querySelector('#order__btn');

        if (orderBtn) {

            if (productPrice <= 0) {

                orderBtn.disabled = true;
                orderBtn.classList.add('disabled');

            } else {

                orderBtn.disabled = false;
                orderBtn.classList.remove('disabled');

            }

        }


      


    } catch (err) {

        console.error(
            'Lỗi tính tổng tiền checkout:',
            err
        );

    }

        
</script>






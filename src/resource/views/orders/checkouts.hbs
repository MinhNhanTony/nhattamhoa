<script>


	 try {
			const userInfor = JSON.parse(localStorage.getItem('userInfor'));
			const {name,phone,email,address} = userInfor;
			function renderUserInfor() {

					try {

						const userInfor =
							JSON.parse(localStorage.getItem('userInfor'));

						if(!userInfor) return;

						// Người gửi
						document.querySelector(
							'.order__sender--name'
						).textContent =
							userInfor.senderName || '--';

						document.querySelector(
							'.order__sender--phone'
						).textContent =
							userInfor.senderPhone || '--';

                        document.querySelector(
							'.order__sender--mail'
						).textContent =
							userInfor.email || '--';


						// Người nhận
						document.querySelector(
							'.order__user--name'
						).textContent =
							userInfor.name || '--';

						document.querySelector(
							'.order__user--phone'
						).textContent =
							userInfor.phone || '--';


						// Địa chỉ
						const address =
							userInfor.address;

						document.querySelector(
							'.order__user--address'
						).textContent =
							`${address.detailAddress},
							${address.ward},
							${address.district},
							${address.provinces}`;

					}
					catch(err){
						console.log(err);
					}

				}

				renderUserInfor();

	 }catch(err) {
		console.log(err);
	 }



</script>




